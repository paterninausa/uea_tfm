# Plantilla de credenciales locales. Copia este archivo a .env (no
# versionado, ver .gitignore) y ajusta los valores si quieres.
#
# Lo lee Docker Compose automaticamente (variables ${...} en
# docker-compose.yml) y los scripts Python via connection_args.py
# (python-dotenv), asi que este archivo basta para las dos rutas.
#
# Son credenciales de desarrollo local, no secretos: el stack no se
# expone fuera de la maquina. Separadas para poder rotar una
# sin tocar la otra.

POSTGRES_USER=tfm
POSTGRES_PASSWORD=tfm_dev_password
TIMESCALE_USER=tfm
TIMESCALE_PASSWORD=tfm_dev_password

# Nombres de los topicos de Kafka. Unica fuente de verdad: los leen Docker
# Compose (servicio bridge) y los scripts Python del host via
# connection_args.py. El broker los auto-crea con el nombre que reciba.
KAFKA_TOPIC_RAW=iot.telemetry.raw
KAFKA_TOPIC_DLQ=iot.telemetry.dlq

# Particiones y factor de replica de los topicos. El broker los aplica como
# default al auto-crear un topico; reset_state.py los usa al recrearlos para
# una medicion. Un solo broker => el factor de replica solo puede ser 1.
KAFKA_NUM_PARTITIONS=3
KAFKA_DEFAULT_REPLICATION_FACTOR=1
