# Plantilla de credenciales locales. Copia este archivo a .env (no
# versionado, ver .gitignore) y ajusta los valores si quieres.
#
# Lo lee Docker Compose automaticamente (variables ${...} en
# docker-compose.yml) y los scripts Python via connection_args.py
# (python-dotenv), asi que un solo archivo basta para las dos rutas.
#
# Son credenciales de desarrollo local, no secretos: el stack no se
# expone fuera de la maquina. Separadas por base para poder rotar una
# sin tocar la otra -antes compartian un unico valor y eso hacia que
# cambiar la de Power BI rompiera en silencio las herramientas que
# conectan a la de Grafana, o viceversa.

POSTGRES_PASSWORD=tfm_dev_password
TIMESCALE_PASSWORD=tfm_dev_password
