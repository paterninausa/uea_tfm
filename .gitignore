# LaTeX build artifacts
*.aux
*.bbl
*.bcf
*.blg
*.log
*.lof
*.lot
*.toc
*.out
*.run.xml
*.synctex.gz
*.fls
*.fdb_latexmk
.texpadtmp/

# macOS
.DS_Store

# Python
__pycache__/
*.pyc
.venv/
venv/

# Docker / pipeline
*.env
.env

# Datos (se generan/descargan localmente, no se versionan)
pipeline/data/raw/
pipeline/data/*.xlsx
pipeline/data/*.parquet
pipeline/data/power_measurements_parquet/

# Registros de ejecucion de los procesos del pipeline. *.log ya queda ignorado
# por la regla de LaTeX de arriba, pero los ficheros que produce la rotacion se
# llaman .log.1, .log.2 ... y no la cumplen.
pipeline/logs/*
!pipeline/logs/.gitkeep

# Material de consulta (TFM de terceros usados como referencia de estilo).
# No se versiona: este repositorio es publico y son trabajos ajenos.
references/

# Editor
.vscode/*
!.vscode/settings.json

# .vscode/settings.json SI se versiona: es configuracion del proyecto (apunta
# al interprete de .venv para que Pylance resuelva los imports del pipeline),
# no preferencias personales. El resto del directorio queda ignorado porque
# puede contener estado local del editor.


# Checkpoints de Spark Structured Streaming (estado local, no versionable)
pipeline/spark/checkpoints/

# Power BI: cache local de sesion del Developer Mode (.pbip), no versionable.
# El modelo (TMDL) y el reporte (PBIR) si se versionan: son texto y son lo
# que hace el dashboard reproducible por terceros.
powerbi/**/.pbi/
powerbi/**/*.abf
powerbi/**/cache.abf
